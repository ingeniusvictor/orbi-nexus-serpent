{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "dev:local": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "check:types": "tsc --noEmit",
    "qa:gate": "node scripts/qa-gate.mjs",
    "qa:assault-landscape": "node scripts/qa-assault-landscape.mjs",
    "qa:assault-geometry": "node --import tsx --test src/gameplay/assault/resonanceGeometry.test.ts src/gameplay/assault/resonancePreview.test.ts",
    "qa:assault-preview-scope": "node scripts/qa-assault-preview-scope.mjs",
    "qa:assault-revive": "node --import tsx --test src/gameplay/assault/assaultRevive.test.ts",
    "qa:assault-revive-scope": "node scripts/qa-assault-revive-scope.mjs",
    "qa:assault-nine-energies": "node scripts/qa-assault-nine-energies.mjs",
    "qa:assault-rv03": "node scripts/qa-assault-rv03.mjs",
    "qa:assault-rv04": "node --import tsx --test src/gameplay/assault/targeting.test.ts src/gameplay/assault/resonanceCombat.test.ts && node scripts/qa-assault-rv04-scope.mjs",
    "qa:assault-rv05": "node --import tsx --test src/gameplay/assault/rarity.test.ts",
    "qa:assault-rv06": "node --import tsx --test src/gameplay/assault/gaiaAwakening.test.ts",
    "qa:assault-rv07": "node --import tsx --test src/gameplay/assault/encounterDirector.test.ts",
    "qa:assault-rv08": "node --import tsx --test src/gameplay/assault/advancedMutations.test.ts src/gameplay/assault/fusionRecipes.test.ts && node scripts/qa-assault-rv08-scope.mjs",
    "qa:assault-rv09": "node --import tsx --test src/gameplay/assault/moduleAnchors.test.ts src/gameplay/assault/gaiaSupremeVisual.test.ts && node scripts/qa-assault-rv09-visual.mjs",
    "qa:assault-rv10": "node --import tsx --test src/gameplay/assault/tacticalFormations.test.ts && npm run qa:assault-rv09",
    "qa:assault-rv10b": "node --import tsx --test src/gameplay/assault/tacticalFormations.test.ts src/gameplay/assault/artilleryTelegraph.test.ts && npm run qa:assault-rv09",
    "qa:assault-rv10c": "node --import tsx --test src/gameplay/assault/blackoutIntelligence.test.ts && node scripts/qa-assault-rv10c-integration.mjs && npm run qa:assault-rv10b",
    "qa:assault-rv11": "node --import tsx --test src/gameplay/assault/visualContinuity.test.ts src/gameplay/assault/serpentBossVisual.test.ts && node scripts/qa-assault-rv11-integration.mjs && npm run qa:assault-rv10c",
    "qa:assault-rv12": "node --import tsx --test src/gameplay/assault/visualContinuity.test.ts && node scripts/qa-assault-rv12-integration.mjs && npm run qa:assault-rv11"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "lucide-react": "^0.546.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^6.2.3",
    "express": "^4.21.2",
    "dotenv": "^17.2.3",
    "motion": "^12.23.24"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
